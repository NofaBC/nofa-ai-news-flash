rules_version = '2';

// All reads/writes to this database happen exclusively through the
// Firebase Admin SDK in server-side Vercel API routes (see lib/firebaseAdmin.js),
// which authenticates with a service account and bypasses these rules
// entirely. No client (browser) ever talks to Firestore directly, so
// direct client access is denied outright.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
