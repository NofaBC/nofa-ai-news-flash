# Firestore / Firebase Admin SDK (required for live data)
# See readme.md "Firebase setup" section for how to obtain these from a
# service account key JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences when pasting the private key value into
# Vercel's dashboard - this code converts them back to real newlines.
FIREBASE_PRIVATE_KEY=

# AI news ingestion (optional - the app degrades gracefully without these,
# it simply will not ingest news until keys are added)
GNEWS_API_KEY=
MEDIASTACK_API_KEY=

# Cron authentication. Generate a random string of 16+ characters and set it
# here AND in the Vercel dashboard. Vercel automatically sends this value as
# "Authorization: Bearer <CRON_SECRET>" on every scheduled cron invocation -
# this is Vercel's own documented cron security mechanism, not a custom one.
CRON_SECRET=

# Password for the internal admin moderation panel (admin.html). A single
# shared secret is sufficient for Phase 1 internal use.
ADMIN_SECRET=
